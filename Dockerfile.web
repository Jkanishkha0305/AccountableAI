FROM node:22-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . .
WORKDIR /app/dashboard
# next.config.mjs bakes the /api rewrite in at build time
ARG FEED_URL=http://app:8765
ENV FEED_URL=$FEED_URL NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=--max-old-space-size=768
RUN npm ci --no-audit --no-fund && npm run build
EXPOSE 3000
CMD ["npm", "start"]
